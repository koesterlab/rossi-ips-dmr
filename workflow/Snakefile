# Main entrypoint of the workflow.
# Please follow the best practices:
# https://snakemake.readthedocs.io/en/stable/snakefiles/best_practices.html,
# in particular regarding the standardized folder structure mentioned there.

from snakemake.utils import min_version

min_version("8.13.0")


container: "docker://continuumio/miniconda3"


report: "report/workflow.rst"


configfile: "config/config.yaml"


include: "rules/common.smk"
include: "rules/dmr_calling.smk"
# include: "rules/methreg.smk"
include: "rules/plots_paper.smk"
include: "rules/prepare_meth_calling.smk"
include: "rules/rna_seq.smk"
# include: "rules/modkit.smk"
# include: "rules/pbCpgTools.smk"
include: "rules/methylation_calling.smk"
# include: "rules/compare_rna_jochen_excel.smk"
include: "rules/annotate_dmrs.smk"
include: "rules/fgsea.smk"

inputflags:
    access.sequential


module kallisto_sleuth_old:
    snakefile:
        # github(
        #     "snakemake-workflows/rna-seq-kallisto-sleuth",
        #     path="workflow/Snakefile",
        #     branch="lr-kallisto"
        # )
        "../../rna-seq-kallisto-sleuth/workflow/Snakefile"
    config:
        # inherit the whole shared config, but override only samples/units
        { **config["kallisto_sleuth"],
          "samples": "config/old_samples.tsv",
          "units": "config/old_units.tsv",
          "report_category_prefix": "old samples" }
    prefix: "rna_old"

module kallisto_sleuth_new:
    snakefile:
        # github(
        #     "snakemake-workflows/rna-seq-kallisto-sleuth",
        #     path="workflow/Snakefile",
        #     branch="lr-kallisto"
        # )
        "../../rna-seq-kallisto-sleuth/workflow/Snakefile"
    config:
        { **config["kallisto_sleuth"],
          "samples": "config/new_samples.tsv",
          "units": "config/new_units.tsv",
          "report_category_prefix": "new samples" }
    prefix: "rna_new"

use rule * from kallisto_sleuth_old as rna_old_*
use rule * from kallisto_sleuth_new as rna_new_*

# ── Separate report categories for the two RNA-seq modules ──────────────────
# The four datavzrd rules inside the module all call report(). Without
# overrides both modules write into the same report sections. We override
# only the output directive to assign distinct subcategories, so that
# "RNA old" and "RNA new" appear as separate entries in the Snakemake report.

