# Main entrypoint of the workflow.
# Please follow the best practices:
# https://snakemake.readthedocs.io/en/stable/snakefiles/best_practices.html,
# in particular regarding the standardized folder structure mentioned there.

from snakemake.utils import min_version

min_version("8.13.0")

container: "docker://continuumio/miniconda3"


report: "report/workflow.rst"


configfile: "config/config.yaml"


include: "rules/common.smk"
include: "rules/dmr_calling.smk"
include: "rules/plots_paper.smk"
include: "rules/prepare_meth_calling.smk"
include: "rules/rna_seq.smk"
include: "rules/methylation_calling.smk"
include: "rules/annotate_dmrs.smk"
include: "rules/expression_to_meth.smk"


# ---------------------------------------------------------------------------
# Differential expression via the kallisto-sleuth workflow, used as a module.
# All contrasts are defined as separate
# models under `kallisto_sleuth: diffexp: models:` in config/config.yaml.
# ---------------------------------------------------------------------------


inputflags:
    access.sequential

# if config.samples.tsv does not exist, skip the module
if exists(config["kallisto_sleuth"]["samples"]):

    module kallisto_sleuth:
        snakefile:
            github(
                "snakemake-workflows/rna-seq-kallisto-sleuth",
                path="workflow/Snakefile",
                tag="v4.1.0",
            )
            # "../../rna-seq-kallisto-sleuth/workflow/Snakefile"
        config: config["kallisto_sleuth"]

    use rule * from kallisto_sleuth


    rule modified_all:
        default_target: True
        input:
            all_input,
            rules.all.input,

    # Narrower target for `snakemake --report`: excludes the kallisto-sleuth module's own targets
    rule report_targets:
        input:
            all_input,
else:
    rule modified_all:
        default_target: True
        input:
            config["kallisto_sleuth"]["samples"]
