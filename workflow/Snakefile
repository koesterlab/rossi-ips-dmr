# ---------------------------------------------------------------------------
# Kallisto-sleuth modules – one pair (old + new RNA data) per base experiment.
# Snakemake modules do not support runtime-dynamic configuration, so we
# instantiate four explicit pairs.  The only thing that differs between them
# is `base_level` inside the `diffexp: models: condition:` block.
# ---------------------------------------------------------------------------

import copy
import os

inputflags:
    access.sequential


module kallisto_sleuth:
    snakefile:
